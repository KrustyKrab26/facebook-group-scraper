# These are the starting values. Most can also be changed on the dashboard
# (Settings button), which saves to data/settings.json and wins over this file.
# One or more groups, separated by commas (or edit the list in Settings)
GROUPS=https://www.facebook.com/groups/your-group-name
SCRAPE_ALL_GROUPS=false
GROUP_PAUSE_MIN=3
SORT_CHRONOLOGICAL=true
MAX_POSTS=100
AUTO_SCROLL_LIMIT=true
SCROLL_LIMIT=40
MAX_IDLE_SCROLLS=4
MIN_DELAY=2
MAX_DELAY=7
HEADLESS=false
BLOCK_MEDIA=true
FAST_FORWARD=true
SKIP_SEE_MORE_SAVED=true
BATCH_MODE=false
BATCH_POSTS=30
BATCH_TOTAL=150
BATCH_REST_MIN=120
RECYCLE_MB=1200
COLLECT_COMMENTS=true
MAX_COMMENTS_PER_POST=3
EXPAND_COMMENTS=true
COLLECT_REACTIONS=true
EXPAND_REACTIONS=true
LOW_RISK_MODE=false
CHECKPOINT_ALERT=true
UPDATE_SAVED=false
UPDATE_SAVED_CLICKS=false
ANONYMIZE=true
HASH_SALT=pick-any-random-string
# Optional
# DATA_DIR=data
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8765
# For servers/Docker only: lets the vault unlock without a prompt.
# Prefer passing it at run time (docker run -e) over writing it here.
# SCRAPER_PASSPHRASE=
# Browser: empty = auto (Playwright Chromium, then Chrome, then Edge), or chromium / chrome / msedge
# BROWSER_CHANNEL=
